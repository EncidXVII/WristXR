# AUR recipe (desktopvr-bin). Update pkgver and sha256sums from the release's .sha256 file.
pkgname=desktopvr-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="Use your desktop in VR without taking the headset off (SteamVR overlay)"
arch=('x86_64' 'aarch64')
url="https://github.com/EncidXVII/DesktopVR"
license=('GPL-3.0-or-later')
depends=('fontconfig' 'pipewire')
optdepends=('steam: SteamVR runtime')
source_x86_64=("$url/releases/download/v$pkgver/DesktopVR-$pkgver-linux-x64.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/DesktopVR-$pkgver-linux-arm64.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  local dir
  dir=$(find "$srcdir" -maxdepth 1 -type d -name 'DesktopVR-*' | head -n1)
  install -Dm755 "$dir/desktopvr" "$pkgdir/usr/bin/desktopvr"
  install -Dm644 "$dir/README.md" "$pkgdir/usr/share/doc/desktopvr/README.md"
  install -Dm644 "$dir/LICENSE" "$pkgdir/usr/share/licenses/desktopvr/LICENSE"
  install -Dm644 "$dir/THIRD_PARTY_NOTICES.md" "$pkgdir/usr/share/licenses/desktopvr/THIRD_PARTY_NOTICES.md"
}
