{
  "controller_type": "holographic_controller",
  "name": "Default",
  "description": "Default desktop overlay bindings",
  "bindings": {
    "/actions/main": {
      "poses": [
        { "output": "/actions/main/in/pointer", "path": "/user/hand/left/pose/tip" },
        { "output": "/actions/main/in/pointer", "path": "/user/hand/right/pose/tip" }
      ],
      "haptics": [
        { "output": "/actions/main/out/haptic", "path": "/user/hand/left/output/haptic" },
        { "output": "/actions/main/out/haptic", "path": "/user/hand/right/output/haptic" }
      ],
      "sources": [
        { "path": "/user/hand/left/input/application_menu", "mode": "button", "inputs": { "click": { "output": "/actions/main/in/menu" } } }
      ]
    },
    "/actions/point": {
      "sources": [
        { "path": "/user/hand/left/input/trigger", "mode": "trigger", "inputs": { "click": { "output": "/actions/point/in/click" } } },
        { "path": "/user/hand/right/input/trigger", "mode": "trigger", "inputs": { "click": { "output": "/actions/point/in/click" } } },
        { "path": "/user/hand/left/input/grip", "mode": "button", "inputs": { "click": { "output": "/actions/point/in/grab" } } },
        { "path": "/user/hand/right/input/grip", "mode": "button", "inputs": { "click": { "output": "/actions/point/in/grab" } } }
      ]
    },
    "/actions/scroll": {
      "sources": [
        { "path": "/user/hand/left/input/joystick", "mode": "joystick", "inputs": { "position": { "output": "/actions/scroll/in/stick" } } },
        { "path": "/user/hand/right/input/joystick", "mode": "joystick", "inputs": { "position": { "output": "/actions/scroll/in/stick" } } }
      ]
    },
    "/actions/right": {
      "sources": [
        { "path": "/user/hand/left/input/trackpad", "mode": "dpad", "parameters": { "sub_mode": "click" }, "inputs": { "south": { "output": "/actions/right/in/rightclick" } } },
        { "path": "/user/hand/right/input/trackpad", "mode": "dpad", "parameters": { "sub_mode": "click" }, "inputs": { "south": { "output": "/actions/right/in/rightclick" } } }
      ]
    }
  }
}
