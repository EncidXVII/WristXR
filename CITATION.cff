version: 0.1.0
date-released: 2026-11-23
license: GPL-3.0-or-later
repository-code: "https://github.com/EncidXVII/WristXR"
url: "https://everyvr.net/wristxr"
keywords:
  - virtual reality
  - SteamVR overlay
  - VR desktop overlay
  - wrist watch
  - VR keyboard
  - VRChat
  - OpenVR
  - Rust
